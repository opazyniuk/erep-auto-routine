#!/usr/bin/env ruby
# frozen_string_literal: true
#
# Simulates the login retry path without needing a real Cloudflare block:
#   1. Boot Browser (phase 1 + phase 2)
#   2. Record port / pid state
#   3. Re-seed clearance (mirrors what login does on CF block)
#   4. Relaunch CDP Chrome
#   5. Confirm a fresh Chrome owns port 9232 and CDP responds (browser.go_to)

require "dotenv/load"
require_relative "../lib/erep"

def port_owner
  `lsof -ti:9232 2>/dev/null`.strip.split("\n").reject(&:empty?)
end

def assert(cond, msg)
  raise "FAIL: #{msg}" unless cond
  puts "  ok — #{msg}"
end

puts "[1] Booting Browser..."
b = Erep::Browser.new
pids_before = b.send(:chrome_pids)
port_before = port_owner
assert !pids_before.empty?, "chrome processes alive after initial boot"
assert !port_before.empty?, "port 9232 bound after initial boot"
puts "    chrome_pids=#{pids_before.inspect} port_owner=#{port_before.inspect}"

puts "[2] Simulating CF retry: browser.quit + re-seed + relaunch..."
b.browser.quit rescue nil
b.send(:seed_cloudflare_clearance)

# After seeding, kill_stale_chrome should have cleared everything
mid = b.send(:chrome_pids)
puts "    chrome_pids after seed cleanup=#{mid.inspect}"
assert mid.empty?, "no chrome left after seed_cloudflare_clearance"
assert port_owner.empty?, "port 9232 released after seed_cloudflare_clearance"

puts "[3] Relaunching CDP Chrome..."
b.send(:launch_chrome_with_cdp)
port_after = port_owner
puts "    new port owner=#{port_after.inspect}"
assert !port_after.empty?, "port 9232 bound by fresh Chrome"

puts "[4] Probing CDP with browser.go_to..."
t0 = Time.now
b.browser.go_to("https://www.erepublik.com/en")
puts "    go_to returned in #{(Time.now - t0).round(2)}s — CDP healthy"

puts "[5] Cleanup..."
b.browser.quit rescue nil
b.send(:kill_stale_chrome)
assert port_owner.empty?, "port 9232 released after cleanup"

puts "\nALL CHECKS PASSED"
